{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Agents Widget",
  "version": "0.10.0",
  "identifier": "com.fgerthoffert.claude-agents-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Agents Widget",
        "width": 320,
        "height": 400,
        "minWidth": 240,
        "minHeight": 120,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
