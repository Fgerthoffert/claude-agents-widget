{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "store:default",
    "autostart:default",
    "process:allow-exit",
    "core:app:allow-version",
    "log:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "comment": "The version of Claude Code the widget is reading, shown in the footer. Same login-shell lookup as the session list, and read once per launch.",
          "name": "claude-version",
          "cmd": "/bin/zsh",
          "args": ["-lc", "claude --version"]
        },
        {
          "comment": "Claude Code's own session list. Run through a login shell because `claude` lives on the user's PATH (/opt/homebrew/bin, ~/.claude/local, a global npm prefix) and a GUI app inherits none of those. The arguments are fixed here, so nothing is interpolated into the shell.",
          "name": "claude-agents-json",
          "cmd": "/bin/zsh",
          "args": ["-lc", "claude agents --json"]
        },
        {
          "name": "ps",
          "cmd": "/bin/ps",
          "args": ["-axo", "pid=,ppid=,command="]
        },
        {
          "name": "ps-tty",
          "cmd": "/bin/ps",
          "args": [
            "-o",
            "tty=",
            "-p",
            {
              "validator": "^[0-9]+$"
            }
          ]
        },
        {
          "name": "osascript",
          "cmd": "/usr/bin/osascript",
          "args": [
            "-e",
            {
              "validator": "-- claude-agents-widget focus\\n[\\s\\S]*"
            }
          ]
        },
        {
          "name": "open-bundle",
          "cmd": "/usr/bin/open",
          "args": [
            "-b",
            {
              "validator": "[A-Za-z0-9][A-Za-z0-9._-]*"
            }
          ]
        },
        {
          "name": "open-settings-pane",
          "cmd": "/usr/bin/open",
          "args": [
            {
              "validator": "x-apple\\.systempreferences:[A-Za-z0-9._?=&-]+"
            }
          ]
        }
      ]
    }
  ]
}
