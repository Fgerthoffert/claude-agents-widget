{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "store:default",
    "autostart:default",
    "process:allow-exit",
    "core:app:allow-version",
    "log:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.claude-agents-widget/sessions/*" },
        { "path": "$HOME/.claude/projects/*/*.jsonl" },
        { "path": "$HOME/.claude/settings.json" },
        { "path": "$HOME/.claude/settings.json.claude-agents-widget.bak" },
        { "path": "$RESOURCE/hooks/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.claude/settings.json" },
        { "path": "$HOME/.claude/settings.json.claude-agents-widget.bak" },
        { "path": "$HOME/.claude-agents-widget/hook.mjs" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.claude-agents-widget/sessions"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/.claude-agents-widget/sessions/*"
        },
        {
          "path": "$HOME/.claude/projects/*/*.jsonl"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.claude-agents-widget/sessions" },
        { "path": "$HOME/.claude-agents-widget/hook.mjs" },
        { "path": "$HOME/.claude/projects/*" },
        { "path": "$HOME/.claude/settings.json" },
        { "path": "$HOME/.claude/settings.json.claude-agents-widget.bak" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.claude-agents-widget" },
        { "path": "$HOME/.claude-agents-widget/sessions" },
        { "path": "$HOME/.claude" }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "$HOME/.claude-agents-widget/sessions"
        },
        {
          "path": "$HOME/.claude-agents-widget/sessions/*"
        }
      ]
    },
    "fs:allow-unwatch",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ps",
          "cmd": "/bin/ps",
          "args": ["-axo", "pid=,ppid=,command="]
        },
        {
          "name": "lsof-cwd",
          "cmd": "/usr/sbin/lsof",
          "args": [
            "-a",
            "-d",
            "cwd",
            "-Fn",
            "-p",
            {
              "validator": "^[0-9,]+$"
            }
          ]
        },
        {
          "name": "ps-tty",
          "cmd": "/bin/ps",
          "args": [
            "-o",
            "tty=",
            "-p",
            {
              "validator": "^[0-9]+$"
            }
          ]
        },
        {
          "name": "osascript",
          "cmd": "/usr/bin/osascript",
          "args": [
            "-e",
            {
              "validator": "-- claude-agents-widget focus\\n[\\s\\S]*"
            }
          ]
        },
        {
          "name": "open-bundle",
          "cmd": "/usr/bin/open",
          "args": [
            "-b",
            {
              "validator": "[A-Za-z0-9][A-Za-z0-9._-]*"
            }
          ]
        },
        {
          "name": "open-settings-pane",
          "cmd": "/usr/bin/open",
          "args": [{ "validator": "x-apple\\.systempreferences:[A-Za-z0-9._?=&-]+" }]
        }
      ]
    }
  ]
}
